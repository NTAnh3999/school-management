# Copy to .env.local to override for your machine (that file is gitignored).
# These are dev-server-only settings — see vite.config.ts. The app itself always calls the
# relative path /api/v1; Vite's dev proxy is what forwards that to the backend below.

# Backend API server (api/), matching its NODE_PORT (api/server.js defaults to 4000 —
# NOT the 3000 in api/README.md or the 5000 this project used to assume).
VITE_API_PROXY_TARGET=http://localhost:4000

# Port this Vite dev server runs on.
VITE_PORT=3001
